# ============================================================
# Aero-Flare Environment Variables
# Copy this file to .env and fill in all values.
# NEVER commit .env — it is gitignored.
# ============================================================

# -----------------------------------------------------------
# NASA FIRMS (Fire Information for Resource Management System)
# Register: https://firms.modaps.eosdis.nasa.gov/api/area/
# -----------------------------------------------------------
FIRMS_API_KEY=

# -----------------------------------------------------------
# Cloudflare R2 (satellite tile storage — 10GB free)
# Create token with "Object Read & Write" on aero-flare-tiles
# -----------------------------------------------------------
CLOUDFLARE_R2_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY=
CLOUDFLARE_R2_SECRET=
CLOUDFLARE_R2_BUCKET_NAME=aero-flare-tiles

# -----------------------------------------------------------
# Supabase (PostgreSQL database only — NOT storage)
# Region: ap-southeast-1 (Singapore)
# -----------------------------------------------------------
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_ANON_KEY=
DATABASE_URL=postgresql+asyncpg://postgres:[password]@[host]:5432/postgres

# -----------------------------------------------------------
# SQLAlchemy Connection Pool
# -----------------------------------------------------------
SQLALCHEMY_POOL_SIZE=5
SQLALCHEMY_MAX_OVERFLOW=10

# -----------------------------------------------------------
# Telegram Bot (fire alert notifications)
# -----------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=

# -----------------------------------------------------------
# Application Security
# Generate API key (minimum 32 chars):
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Rotate every 30 days; update Railway, Vercel, and GitHub Actions secrets.
# ❌ NEVER: API_KEY="" or API_KEY=changeme
# ✅ ALWAYS: a cryptographically random 32+ char string
# -----------------------------------------------------------
API_KEY=
SECRET_KEY=
ENVIRONMENT=development

# -----------------------------------------------------------
# Ollama (local VLM inference)
# Production: expose via Cloudflare Tunnel (not directly to internet)
#   cloudflared tunnel --url http://localhost:11434
# Dev: direct localhost access
# -----------------------------------------------------------
OLLAMA_BASE_URL=http://localhost:11434
VLM_MODEL=qwen2-vl:7b
VLM_FALLBACK_MODEL=llava:13b

# -----------------------------------------------------------
# XGBoost Model
# -----------------------------------------------------------
XGBOOST_MODEL_PATH=ml/models/xgboost_spread_v1.0.0.ubj

# -----------------------------------------------------------
# Redis (Distributed Caching & Task Queue)
# -----------------------------------------------------------
REDIS_URL=redis://localhost:6379/0
CACHE_ENABLED=true
QUEUE_ENABLED=true

# -----------------------------------------------------------
# Grafana Cloud / OpenTelemetry (observability)
# Free plan: 14-day retention
# -----------------------------------------------------------
GRAFANA_OTLP_ENDPOINT=
GRAFANA_INSTANCE_ID=
GRAFANA_API_TOKEN=


# -----------------------------------------------------------
# Open-Meteo (weather features — completely free, no key)
# -----------------------------------------------------------
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1/

# -----------------------------------------------------------
# Frontend (server-side only — Vercel / Next.js API Route)
# NEVER use NEXT_PUBLIC_ prefix for these — they'd be visible in the browser bundle.
# In Vercel dashboard: add as plain (not NEXT_PUBLIC_) environment variables.
# -----------------------------------------------------------
BACKEND_API_URL=http://localhost:8000
BACKEND_API_KEY=
