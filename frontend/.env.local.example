# ─── Environment Variables for Aero-Flare Frontend ───────────────────────────
# Copy to .env.local for local development.
# Never commit .env.local — it is git-ignored.

# ─── Public (safe to expose to browser) ──────────────────────────────────────
NEXT_PUBLIC_MAP_CENTER_LAT=0.0
NEXT_PUBLIC_MAP_CENTER_LON=118.0

# ─── Server-side ONLY ─────────────────────────────────────────────────────────
# These are read ONLY inside Next.js API route handlers (src/app/api/proxy/*).
# NEVER prefix with NEXT_PUBLIC_ — that would embed them in the JS bundle.

BACKEND_API_URL=https://aero-flare-backend.railway.app
BACKEND_API_KEY=your-secret-key-min-32-chars

# ─── ❌ NEVER DO THIS ─────────────────────────────────────────────────────────
# NEXT_PUBLIC_API_KEY=...  ← visible to everyone in DevTools
